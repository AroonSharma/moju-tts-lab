# Pick a default provider — clients can still override via ?provider=…
TTS_PROVIDER=google
TTS_LANGUAGE=hi-IN
TTS_SAMPLE_RATE=16000
TTS_PORT=8090

# Sarvam — wss://api.sarvam.ai/text-to-speech/ws
SARVAM_API_KEY=
SARVAM_VOICE=Shubh
SARVAM_MODEL=bulbul:v3
SARVAM_PACE=0.85

# Google Cloud TTS — REST v1 (uses API key, no SDK)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=hi-IN-Neural2-A
GOOGLE_TTS_SPEAKING_RATE=0.85

# Cartesia — wss://api.cartesia.ai/tts/websocket
CARTESIA_API_KEY=
CARTESIA_VERSION=2024-11-13
CARTESIA_MODEL=sonic-2
CARTESIA_VOICE=

# Smallest.ai
# v2 = older but has the Indic voice roster ("diya", "raj", etc.) — the
#      default below works out of the box for Hindi.
# v3.1 = newer; set SMALLEST_MODEL=lightning-v3.1 and
#        SMALLEST_ENDPOINT=https://api.smallest.ai/waves/v1 to use it
#        (and pick a voice from `node scripts/list-voices.js --provider smallest`).
SMALLEST_API_KEY=
SMALLEST_MODEL=lightning-v2
SMALLEST_VOICE=diya
SMALLEST_ENDPOINT=https://waves-api.smallest.ai/api/v1

# ElevenLabs — wss://api.elevenlabs.io/v1/text-to-speech/{voice}/stream-input
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE=
